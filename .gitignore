# Harness runtime & generated directories
.claude/skills/
.omp/*
!.omp/config.yml
!.omp/hooks/
!.omp/mcp.json
.omp/plugins/
.agents/vendor-skills/
.agents/skills.json
.agents/omp-bridge/
.superpowers/

# Session logs & temporary files
journal/sessions/*
!journal/sessions/.gitignore
tmp/
.cache/

# Heavy media & renders (keep video projects outside this repo)
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.wav
*.aiff
*.flac

# Dependencies, Python, OS & secrets
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
*.pem
*.key
*.log
